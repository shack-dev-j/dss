# NamPS OS — Environment Configuration
# Copy to .env.local for local development.
# The app REFUSES TO START if DATABASE_URL, SESSION_SECRET or ANONYMOUS_PEPPER is missing.

# Database
#   postgresql://user:pass@host:5432/db   -> PostgreSQL (production, Docker Compose)
#   pglite:./.data/dev                    -> embedded Postgres, no Docker needed (local dev)
DATABASE_URL=pglite:./.data/dev

# Random secrets. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
ANONYMOUS_PEPPER=replace-with-at-least-16-random-characters

# Demo mode: enables /api/demo/reset and the role switcher. NEVER set in production.
DEMO_MODE=true

# Optional modules that are hidden unless listed (comma-separated) or "all":
#   suggestions,guardian,events,projects,facilities,knowledge,workload
FEATURES=

# Password for seeded demo users (default: Demo123!)
# SEED_PASSWORD=

# Apply SQL migrations when the server starts (set by docker-compose; locally use `pnpm db:migrate`)
# MIGRATE_ON_START=true

# Where homework attachments are stored (default ./.data/uploads). Back this folder up together with the database.
# UPLOAD_DIR=./.data/uploads
