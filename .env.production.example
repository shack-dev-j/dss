# Copy to .env (never commit it). Generate secrets with: openssl rand -hex 32

# --- required ---
POSTGRES_PASSWORD=
SESSION_SECRET=
ANONYMOUS_PEPPER=

# --- HTTPS ---
DOMAIN=school.example.uz
# CADDY_TLS="tls internal"        # for a LAN name / no public domain

# --- first start only: creates the first administrator if the database is empty (min 12 chars) ---
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME="Full Name"

# --- optional ---
# POSTGRES_USER=namps_user
# POSTGRES_DB=namps_os
# FEATURES=                       # leave empty for v1; see README for optional modules
# BACKUP_HOUR_UTC=21
# BACKUP_KEEP_DAYS=14
# DEMO_MODE must stay unset/false in production
